{
  "name": "claudable",
  "version": "2.0.0",
  "description": "AI-Powered Web App Builder - Build apps with natural language using Claude Code",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/run-web.js",
    "dev:web": "node scripts/run-web.js",
    "dev:desktop": "node scripts/run-desktop.js",
    "dev:electron": "npm run dev:desktop",
    "ensure:env": "node scripts/setup-env.js",
    "build": "next build --webpack",
    "build:desktop": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "db:backup": "node -e \"require('./scripts/migrate-drop-legacy.js').runBackupCli()\"",
    "db:migrate-legacy": "node scripts/migrate-drop-legacy.js",
    "clean": "rm -rf node_modules package-lock.json",
    "setup": "npm install && prisma generate && prisma db push",
    "postinstall": "npm run ensure:env"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.246",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.5.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "ai",
    "claude",
    "app-builder",
    "nextjs",
    "code-generation",
    "no-code",
    "low-code"
  ],
  "author": "Claudable Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anymorph-ai/Claudable.git"
  },
  "build": {
    "appId": "com.claudable.desktop",
    "productName": "Claudable",
    "files": [
      "index.js",
      "electron/**/*",
      ".next/standalone/**/*",
      "!.next/standalone/.env",
      "!.next/standalone/.env.production",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/static",
        "to": ".next/static"
      },
      {
        "from": "public",
        "to": "public"
      }
    ],
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "dist"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  }
}
